# Secrets; retain safe templates
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# Dependencies, caches, and logs
node_modules/
.npm/
.pnpm-store/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Expo, Metro, native builds, and exports
.expo/
dist/
web-build/
.metro-health-check*
.kotlin/
*.tsbuildinfo
/mobile/ios/
/mobile/android/
/mobile/expo-env.d.ts
