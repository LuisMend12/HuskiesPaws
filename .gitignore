**/.claude/settings.json

# OS, Python, tests, and temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
coverage/
.nyc_output/

