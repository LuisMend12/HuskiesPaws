# Photon Spectrum credentials: app.photon.codes -> your project -> Settings.
# Copy this file to .env and fill in the values. Never commit .env.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Optional: your own phone number (with country code, e.g. +16075551234).
# When set, Pip texts you first when the agent starts. Handy for demos.
DEMO_PHONE_NUMBER=

# Optional: ElevenLabs API key (elevenlabs.io -> Settings -> API keys).
# When set, Moss follows each "story" with a voice note.
ELEVENLABS_API_KEY=
