\definecolor{bigred}{HTML}{B31B1B}
\definecolor{okgreen}{HTML}{1B7F3B}
\definecolor{warnamber}{HTML}{B36B00}

\titleformat{\section}{\large\bfseries\color{bigred}}{}{0em}{}
