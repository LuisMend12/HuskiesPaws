\lhead{BigRed//Hacks 2026 --- SpaceX Track Idea}
\cfoot{\thepage}

% \ideatitle{Name}{One-line pitch}
\newcommand{\ideatitle}[2]{%
  \rhead{#1}%
  {\LARGE\bfseries\color{bigred}#1\par}
  \vspace{0.3em}
  {\large\itshape #2\par}
  \vspace{0.5em}\hrule\vspace{0.8em}}

% Track-requirement checklist rows: \req{requirement}{how we meet it}
\newcommand{\req}[2]{\textbf{#1} & #2 \\}

% Ratings 1-5: \rating{label}{score}{note}
\newcommand{\rating}[3]{#1 & \textbf{#2}/5 & #3 \\}

% Limitation entry: \limitation{title}{problem}{mitigation}
\newcommand{\limitation}[3]{%
  \item \textbf{\color{warnamber}#1.} #2\\
        \textit{\color{okgreen}Mitigation:} #3}

\endinput
