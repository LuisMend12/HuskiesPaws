# HuskiesPaws server settings. Put these in the repo-root .env (shared with the
# web app's serve.py) or in server/.env. Never commit real values.

# Grok (xAI): console.x.ai -> API Keys. Turns on Grok Voice and Grok Imagine.
XAI_API_KEY=

# Mapbox public token (starts with pk.). The only value the browser ever sees.
MAPBOXKEY=

# Optional: Supabase, so leaderboards and turf survive restarts and redeploys.
# Supabase dashboard -> Project Settings -> API. Use the service_role key: it
# stays on this server and is never sent to browsers. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional tuning (defaults shown). These protect your Grok budget.
# PORT=8765
# VOICE_PER_MINUTE=20
# VOICE_PER_DAY=1000
# IMAGES_PER_MINUTE=6
# IMAGES_PER_DAY=200
