{
  "expo": {
    "name": "HuskiesPaws",
    "slug": "huskiespaws",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HuskiesPaws uses your location to grow flowers along your walk and find places nearby."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "HuskiesPaws counts your steps to grow your rank."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HuskiesPaws uses the camera to capture landmarks as postcards."
        }
      ]
    ]
  }
}
