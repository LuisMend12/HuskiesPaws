{
  "expo": {
    "name": "HuskiesPaws",
    "slug": "huskiespaws",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "huskiespaws",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.huskiespaws.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.huskiespaws.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HuskiesPaws uses your location to grow flowers along your walk and find places nearby."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "HuskiesPaws counts your steps to grow your rank."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HuskiesPaws uses the camera to capture landmarks as postcards."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0B1F3A"
        }
      ],
      "expo-asset",
      "expo-dev-client",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "b8bbd2d5-ac4e-4e3f-8bbd-80c7c9793e74"
      }
    }
  }
}
