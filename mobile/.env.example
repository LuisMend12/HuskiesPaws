# Expo public config (safe to ship in the app bundle)

# HTTPS URL of the HuskiesPaws server. No API keys here.
# `npm run tunnel` sets this for you while it runs. For Expo LAN / a deploy:
# EXPO_PUBLIC_API_URL=https://your-service.onrender.com
EXPO_PUBLIC_API_URL=

# Optional. Same E.164 number Photon texts (e.g. +18609890738), so Pip can
# report today's steps and places you passed. Not a secret.
# EXPO_PUBLIC_PHOTON_PHONE=+16075551234
EXPO_PUBLIC_PHOTON_PHONE=
